# ═══════════════════════════════════════════════════════════════════
# Seguridad — AxisWorks · 27-jul-2026
# Estándar: contexto/seguridad_2026.md §1 (sitio estático + PHP simple)
#
# MOTIVO DE URGENCIA: hasta hoy `private/leads.csv` se servía en abierto
# (HTTP 200 en https://sumbahills.lawangproperties.com/private/leads.csv)
# con nombre, WhatsApp, email e IP de cada lead — brecha RGPD/UU PDP.
# `private/` está en .gitignore, así que un .htaccess DENTRO de esa carpeta
# no lo repone ningún deploy (le pasó a Lawang el 8-jul-2026). Esta regla,
# en la raíz, SÍ está versionada y vuelve con cada push.
# ═══════════════════════════════════════════════════════════════════

# ── 1. Cabeceras de seguridad ──────────────────────────────────────
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# ── 2. Sin listado de directorios ──────────────────────────────────
Options -Indexes

# ── 3. Ficheros que nunca se sirven en público ─────────────────────
# `csv` incluido: leads.csv son datos personales. Los .txt se dejan pasar
# (robots.txt, llms.txt) y los .pdf también (el folleto es la descarga).
<FilesMatch "\.(md|sql|zip|bak|log|csv|sh|ini|yml|yaml|psd|ai)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# ── 4. Carpeta privada y control de versiones ──────────────────────
RedirectMatch 404 (?i)/\.git
RedirectMatch 404 (?i)/private/
RedirectMatch 404 (?i)/(Backups?|Deprecated)/

# ── URLs limpias: /terms en vez de /terms.html ─────────────────────
# Solo raiz y solo GET a proposito: las subcarpetas (api/, private/) son endpoints
# con POST, y un 301 convierte un POST en GET — ahi romperia los formularios.
# Cuidado al anadir alias: mod_rewrite corre ANTES que mod_alias, asi que un
# "Redirect" hacia un .html se lo come la regla 1 y acaba en 404. Van como RewriteRule.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) La URL con extension redirige a la limpia: una sola URL indexable.
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{THE_REQUEST} "\s/+index\.html[\s?]" [NC]
  RewriteRule ^ / [R=301,L,NE]

  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{THE_REQUEST} "\s/+([^/\s?]+?)\.(html|php)[\s?]" [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # 2) La URL limpia sirve el fichero real sin que el navegador vea la extension.
  #    ^([^/.]+)$ = solo raiz y sin puntos: data.json, robots.txt y assets no entran.
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([^/.]+)$ $1.html [L]
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^([^/.]+)$ $1.php [L]
</IfModule>
